# Nothing is required: development talks to http://localhost:8000/api/v1, and production builds use the same-origin /api/v1
# (Vercel's rewrite in vercel.json forwards it to the API).
#
# Optional: point the UI at a different API at build time.
# NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
#
# Optional: contact address shown in the Privacy Policy / Terms.
# NEXT_PUBLIC_CONTACT_EMAIL=
#
# Optional support chat (also run the server with CSP_ALLOW_CRISP=true).
# NEXT_PUBLIC_CRISP_WEBSITE_ID=
#
# The old NEXT_PUBLIC_BACKEND_URL is no longer read. If an old Vercel project still has it, delete it:
#   npx vercel env rm NEXT_PUBLIC_BACKEND_URL production
