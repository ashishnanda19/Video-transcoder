# ─── Database ────────────────────────────────────────────────
REDIS_URL=
MONGO_URI=

# ─── Server ──────────────────────────────────────────────────
PORT=8000

# ─── AWS Credentials (IAM User) ──────────────────────────────
MY_AWS_ACCESS_KEY_ID=
MY_AWS_SECRET_ACCESS_KEY=

# ─── S3 Buckets ──────────────────────────────────────────────
TEMP_S3_BUCKET_NAME=
FINAL_S3_BUCKET_NAME=

# ─── ECS Configuration ───────────────────────────────────────
# ECS Cluster name (e.g. video-transcoder-cluster)
CLUSTER=
# ECS Task Definition ARN or name:revision (e.g. video-transcoder-task:1)
TASK=
# Comma-separated subnet IDs from your VPC (e.g. subnet-abc123,subnet-def456)
ECS_SUBNETS=
# Security Group ID that allows outbound traffic for ECS tasks
ECS_SECURITY_GROUP=

# ─── GPU transcoding (ECS on EC2, scale-to-zero) ─────────────
# gpu | cpu. THE rollback switch: "cpu" sends jobs to the Fargate cluster above, exactly as before.
TRANSCODE_MODE=cpu
# From `terraform output` in /infra
GPU_CLUSTER=
GPU_TASK=
GPU_CAPACITY_PROVIDER=
# Optional worker tuning, forwarded to the container (see docs/gpu-migration.md)
# TRANSCODE_STRATEGY=split        # split = one ffmpeg decodes once, encodes 4 rungs | separate = one process per rung
# GPU_CODEC=h264                  # h264 | hevc
# GPU_FALLBACK_TO_CPU=true

# ─── Concurrency limiter (leaky bucket) ──────────────────────
# Unset = derived from hardware (gpu: GPU_ASG_MAX_SIZE x GPUs/instance x jobs/GPU; cpu: 5). May lower, never exceed,
# the gpu ceiling. See server/src/jobs/limiterConfig.js for the reasoning.
# MAX_CONCURRENT_JOBS=
# GPU_ASG_MAX_SIZE=2              # keep equal to Terraform asg_max_size
# LEAK_RATE=                      # max queued jobs released per tick/event (default = MAX_CONCURRENT_JOBS)
# LEAK_INTERVAL_MS=20000          # backstop poll interval
# JOBS_PER_GPU=1                  # >1 only if the task definition stops reserving a whole GPU; bounded by VRAM / NVENC
# GPU_MEMORY_PER_JOB_GIB=3        # estimate -- measure with nvidia-smi during the benchmark
# NVENC_SESSIONS_PER_GPU=         # unset = unknown. Set from benchmark results.

# ─── Google OAuth ────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Format: <your-render-backend-url>/api/v1/user/login
GOOGLE_CALLBACK_URL=

# ─── App URLs ────────────────────────────────────────────────
# Your Vercel frontend URL (no trailing slash)
FRONTEND_URL=
# A long random string for session signing
SESSION_SECRET=

# ─── Webhook ─────────────────────────────────────────────────
# Format: <your-render-backend-url>/api/v1/video/ecs-trigger
WEBHOOK_URL=
